# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions (if compiling C/C++ extensions later)
*.so

# Environment Variables & Secrets (CRITICAL)
.env
.env.local
.env.*.local
*.env

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# IDE & Editor configs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Distribution / Packaging
build/
dist/
*.egg-info/
.eggs/

# RouteGrid data / temporary caches
data/sample_emails/*.eml
!data/sample_emails/.gitkeep
*.log

# Routing queues (contain real mail)
queues/*
!queues/.gitkeep